# Variáveis públicas incorporadas pelo Vite durante o deploy
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
# Alternativa para projetos antigos:
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Exclusivas das funções server-side da Vercel
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUA_CHAVE_SECRETA
APP_URL=https://SEU-PROJETO.vercel.app

# Webhook Dumonti → StudioDesk; usar o mesmo segredo nos dois projetos
LEADS_WEBHOOK_SECRET=gere_um_segredo_longo_e_aleatorio
LEADS_WEBHOOK_WORKSPACE_ID=UUID_DO_WORKSPACE_AUTORIZADO

# Rate limit compartilhado exigido em produção
UPSTASH_REDIS_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_REDIS
