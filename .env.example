# Variáveis públicas incorporadas pelo Vite durante o deploy
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Alternativa para projetos antigos (use esta OU PUBLISHABLE_KEY)
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Variáveis exclusivas das funções server-side da Vercel
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SUA_CHAVE_SECRETA
APP_URL=https://SEU-PROJETO.vercel.app

# Webhook de leads: assine `${timestamp}.${json}` com HMAC-SHA256 e envie
# x-studiodesk-webhook-timestamp e x-studiodesk-webhook-signature.
LEADS_WEBHOOK_SECRET=gere_um_segredo_longo_e_aleatorio
